__pycache__/
*.pyc
.DS_Store
# Regenerated by the pipeline, too large to track. data/ holds the imported
# molecule table, the conformer caches and the frozen embeddings; predictions/
# the tidy per-fold files of all seven arms, five of them copies from
# expansion-ml-comparison; diagnostics/ one file per fine-tuned fold.
data/
folds/
predictions/
diagnostics/
logs/
scratch/
# The sweep's raw output. 05_collect_metrics.py reduces it to fold_metrics.csv,
# which is what every figure, table and the report read, so that is tracked.
results/*/predictions_all.parquet
# Figures are cheap to rebuild from fold_metrics.csv. The ones the report leads
# with are tracked, so a checkout without the predictions still shows them.
results/*/figures/*
!results/*/figures/tukey_mae.png
!results/*/figures/tukey_r2.png

# The report is built here; its builder publishes the copy in docs/reports/.
results/report.html

# Reference material and third-party weights, not ours to redistribute.
*.pdf
*.pt
*.ckpt
*.safetensors
*.pkl
