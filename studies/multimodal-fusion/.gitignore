# Regenerated by the pipeline, too large to track.
data/
folds/
predictions/
scratch/
logs/

# The sweep's raw output. 06_collect_metrics.py turns all of it into the
# fold_metrics files beside it, which is what every figure, table and the report
# actually read, so those are tracked and this is not.
#
#   results/<ds>/predictions_all.parquet   92 MB and 30 MB
#   results/<ds>/control/                  the late-fusion leakage control, per fold
#   results/<ds>/paper_gnn/                the 30-wide GNN block control, per fold
results/*/predictions_all.parquet
results/*/control/
results/*/paper_gnn/

# Figures are tracked as PNG; the SVG beside each one is the same picture.
results/*/figures/*.svg

# The report is built here and published from docs/reports/ at the top level.
results/report.html
results/report_artifact.html

# Phase markers, not results.
results/.done
results/*/.tuned

# Reference material that is not ours to redistribute.
*.pdf

__pycache__/
*.pyc
.DS_Store
