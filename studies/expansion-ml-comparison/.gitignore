# Regenerated by the pipeline, too large to track.
data/
folds/
predictions/
scratch/
logs/
results/*/figures/*
!results/*/figures/tukey_r2.png
!results/*/figures/r2_table.png
!results/*/figures/spearman_table.png
!results/*/figures/mae_table.png
results/report.html
results/*/report.html
results/trimole_report.html
# The Trimole comparison keeps its figures one level deeper, under
# results/<data set>/trimole/. Same rule, same two exceptions worth tracking.
results/*/*/figures/*
!results/*/*/figures/tukey_r2.png
!results/*/*/figures/trimole_selection.png
# One JSON per fold recording the whole 60-candidate pool. The aggregate that the
# report actually reads is tables/selection.csv, which stays tracked.
results/*/trimole_selection/
results/*/.*_done
results/.*_done
# The control run behind the Mol-JEPA section -- 225 more prediction files. The
# two overlap CSVs next to it are evidence, not bulk, so they stay tracked.
results/*/sensitivity/moljepa_tabpfn/

# Local notes and reference material that is not ours to redistribute.
writing.md
mega_cl_weights_email.*
*.pdf
sync_*.sh

# Third-party pre-trained weights. Downloaded from their authors, not ours to
# redistribute, and far too large to track. 12b_extract_kpgt.py says where the
# KPGT checkpoint comes from.
pretrained.zip
*.pth

__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/
