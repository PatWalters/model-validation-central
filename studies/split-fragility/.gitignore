# Regenerated by the pipeline, too large to track. 00_prepare_data.py rebuilds
# data/ and folds/ from upstream/ in about ten seconds; the runners rebuild
# predictions/ in about six GPU-hours.
data/
folds/
predictions/
scratch/
logs/

# What upstream/ holds is the opposite case and stays tracked: the ten raw CSVs,
# both copies of the split indices, and the two released metric files. The two
# copies disagree on three of the six schemes, so which bytes this study read is
# not reconstructible from a URL and has to travel with it.

# The sweep's raw output. 07_collect_metrics.py turns all of it into
# fold_metrics.csv beside it, which is what every figure, table and the report
# actually read, so that is tracked and this is not.
results/predictions_all.parquet

# Figures are cheap to rebuild from fold_metrics.csv. The five that carry the
# argument are tracked so the README and a checkout without the predictions
# still show it.
results/*/figures/*
!results/*/figures/mae_by_split.png
!results/*/figures/gap_to_baseline.png
!results/*/figures/tukey_mae.png
!results/*/figures/similarity_by_split.png
!results/*/figures/decay_with_distance.png
results/figures/*
!results/figures/mae_by_split.png
!results/figures/gap_to_baseline.png
!results/figures/tukey_mae.png
!results/figures/similarity_by_split.png
!results/figures/decay_with_distance.png

# The report is built here and published from docs/reports/ at the top level.
results/report.html
results/*/report.html

# Reference material that is not ours to redistribute.
*.pdf

__pycache__/
*.pyc
.DS_Store
