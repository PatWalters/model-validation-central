# Every study directory carries its own .gitignore for what its own pipeline
# regenerates. This file is only for things that turn up anywhere.
__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/

# Reference material that is not ours to redistribute. Each study keeps the
# papers it was built from next to its code; none of them belong in the
# repository. Repeated here as well as in each study so a study directory
# dropped in without its own rule is still covered.
*.pdf
*.epub

# Third-party pre-trained weights, likewise. Each study's README says where its
# checkpoints come from and under what licence.
*.pt
*.pth
*.ckpt
*.safetensors

# Credentials. Nothing here needs any — the only network call in the repository
# fetches a public data set — so anything matching these turned up by accident
# and should not be committed.
.env
.env.*
*.pem
*.key
